# pr-autoreview config. Sourced by the scripts (bash syntax).

# Only look at PRs in this GitHub org. Empty = every repo you can see.
ORG=""

# Skip a PR if ANY of these people already submitted a review on it.
SKIP_IF_REVIEWED_BY="balajee-r RobinJesba ks-keshava-rao"

# Cap per run so one busy morning doesn't burn your token budget.
MAX_PRS_PER_RUN=5

# false = post as a PENDING review that only you can see; you click Submit.
# true  = post as a submitted COMMENT review straight away.
AUTO_SUBMIT=false

# true = build everything and write payload.json, but post nothing to GitHub.
DRY_RUN=true

# Max number of P3 (nit / judgement) comments per PR.
MAX_NITS=3

# Footer on every comment so teammates know it was AI-assisted.
COMMENT_TAG="🤖 AI-assisted review, verified before posting"

# Where clones, worktrees, run bundles and state live.
STATE_DIR="$HOME/.pr-autoreview"
