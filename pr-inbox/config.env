# pr-inbox config. Sourced as bash.

# Only watch your PRs in this GitHub org. Empty = all of them.
ORG="Adaptavant"

# Only these repos (space-separated owner/name). Overrides ORG. Lists each repo directly instead of
# using GitHub search, which returns nothing for some accounts.
REPOS="Adaptavant/Switchboard Adaptavant/SB6 Adaptavant/switchboard-email-service"

# Extra logins to ignore (CI bots that don't end in [bot], for example).
IGNORE_AUTHORS=""

# Notify about comments from accounts ending in [bot] too.
INCLUDE_BOTS=false

# Where to notify. Turn on as many as you like.
NOTIFY_MACOS=true      # desktop notification (macOS)
NOTIFY_LINUX=false     # notify-send (Linux)
SLACK_WEBHOOK_URL=""   # Slack incoming webhook, e.g. pointed at a DM to yourself
TELEGRAM_CHAT_ID="8602189553"    # your chat id with the bot; the bot token lives in telegram.env (gitignored)
# telegram.env holds TELEGRAM_BOT_TOKEN so the secret never lands in git.
[[ -f "$(dirname "${BASH_SOURCE[0]}")/telegram.env" ]] && source "$(dirname "${BASH_SOURCE[0]}")/telegram.env"

# false = notify only; you start /pr-brief when you want it (no tokens spent).
# true  = also exit 0 when there's something new, so an Orca automation runs /pr-brief for you.
AUTO_BRIEF=true

STATE_DIR="$HOME/.pr-inbox"
